# Copy this file to .env and fill in local-only values.

# Required for live Mapbox satellite camera frames. If unset, the app still
# runs and the camera pane shows an unavailable state.
MAPBOX_ACCESS_TOKEN=

# Optional camera settings.
CAMERA_ENABLED=true
CAMERA_HZ=2
MAPBOX_STYLE=satellite-streets-v12

# Local service defaults.
WS_PORT=8080
BROADCAST_HZ=20
MAVLINK_LISTEN_PORT=14550
MAVLINK_PX4_HOST=127.0.0.1
MAVLINK_PX4_PORT=18570
